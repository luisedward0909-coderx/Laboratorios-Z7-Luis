#include <iostream>
using namespace std;

// pide cuantas notas se van a ingresar, repite hasta que sea mayor a 0
int pedirCantidad() {
    int total;
    cout << "Digite cuantas notas va a ingresar: ";
    cin >> total;

    while (total <= 0) {
        cout << "Tiene que ser mayor a 0, intente otra vez: ";
        cin >> total;
    }

    return total;
}

// pide cada nota (0 a 100) y devuelve el promedio
double sacarPromedio(int total) {
    double valor;
    double acumulado = 0.0;

    for (int i = 1; i <= total; i++) {
        cout << "Digite la nota " << i << " (0 - 100): ";
        cin >> valor;

        while (valor < 0.0 || valor > 100.0) {
            cout << "Nota no valida, digite un valor entre 0 y 100: ";
            cin >> valor;
        }

        acumulado += valor;
    }

    return acumulado / total;
}

// devuelve 1 si aprobo y 0 si reprobo
int revisarEstado(double prom) {
    if (prom >= 51.0) {
        return 1;
    } else {
        return 0;
    }
}

void imprimirResultados(double prom, int aprobo) {
    cout << "Promedio: " << prom << endl;
    if (aprobo == 1) {
        cout << "Resultado: Aprobado" << endl;
    } else {
        cout << "Resultado: Reprobado" << endl;
    }
}

int main() {
    int cantidad = pedirCantidad();
    double promedio = sacarPromedio(cantidad);
    int estado = revisarEstado(promedio);

    imprimirResultados(promedio, estado);

    return 0;
}
