#include <iostream>

using namespace std;

int main() {
    int n;
    double suma = 0.0;

    cout << "Ingrese un numero entero positivo N: ";
    cin >> n;

    if (n <= 0) {
        cout << "El numero debe ser entero positivo.";
        return 0;
    }

    for (int i = 1; i <= n; i++) {
        suma = suma + (1.0 / i);
    }

    cout << "La suma de la serie es: " << suma;

    return 0;
}
