#include <iostream>

using namespace std;

int main() {
    const int MAX = 100;
    double notas[MAX];
    int n;
    double suma = 0.0;
    double promedio = 0.0;
    double mayor;
    double menor;

    cout << "Ingrese la cantidad de estudiantes: ";
    cin >> n;

    while (n < 1 || n > 100) {
        cout << "Cantidad invalida. Ingrese un valor entre 1 y 100: ";
        cin >> n;
    }

    for (int i = 0; i < n; i++) {
        cout << "Nota estudiante " << i + 1 << ": ";
        cin >> notas[i];

        while (notas[i] < 0.0 || notas[i] > 100.0) {
            cout << "Nota invalida. Ingrese un valor entre 0 y 100: ";
            cin >> notas[i];
        }
    }

    mayor = notas[0];
    menor = notas[0];

    for (int i = 0; i < n; i++) {
        suma = suma + notas[i];

        if (notas[i] > mayor) {
            mayor = notas[i];
        }

        if (notas[i] < menor) {
            menor = notas[i];
        }
    }

    promedio = suma / n;

    cout << "NOTAS REGISTRADAS" << endl;
    for (int i = 0; i < n; i++) {
        cout << notas[i] << " ";
    }
    cout << endl;

    cout << "Promedio general: " << promedio << endl;
    cout << "Nota mayor: " << mayor << endl;
    cout << "Nota menor: " << menor << endl;

    return 0;
}
